# ============================================================
# Magento Platform — LOCAL Development Environment
# Copy to env/.env.local (gitignored) and adjust if needed:
#   cp env/.env.local.example env/.env.local
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_ENV=local
APP_NAME=magento
# Drives base_url, the generated TLS cert, and the generated nginx config
# (config/nginx-local/default.conf, templated from default.conf.template) —
# bin/local/setup prompts for and applies all of this together.
APP_DOMAIN=local.magento.test
APP_TIMEZONE=America/New_York

# Optional overrides — leave blank to keep Magento's own sane defaults
# (media/static URLs derived from base_url; cookie domain left to the
# current host). bin/local/setup prompts for these once; bin/refresh
# reapplies them every run (sync-db's DB reimport would otherwise reset
# them on every refresh).
BASE_MEDIA_URL=
BASE_STATIC_URL=
COOKIE_DOMAIN=

# The production site an imported dump came from — the URLs and cookie
# domain the DB refresh rewrites to this local site's. Written by the
# refresh, which reads them from the dump itself; only a fallback for a
# dump that doesn't carry them. Leave blank.
PROD_BASE_URL=
PROD_MEDIA_URL=
PROD_COOKIE_DOMAIN=

# ------------------------------------------------------------
# Docker Images / Versions — a fresh install (and setup, when it detects an
# existing Magento version) sets these from Adobe's system requirements via
# the m2/ catalog (m2/<version>/[p<N>/]version.env).
# ------------------------------------------------------------

NGINX_VERSION=1.29
PHP_VERSION=8.4
MARIADB_VERSION=11.4
VALKEY_VERSION=8
RABBITMQ_VERSION=4
OPENSEARCH_VERSION=3
VARNISH_VERSION=7.5
COMPOSER_VERSION=2
# Debian release of the custom php/nginx images: bookworm | trixie
DEBIAN_RELEASE=bookworm

# ------------------------------------------------------------
# PHP
# ------------------------------------------------------------

PHP_MEMORY_LIMIT=2G
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M
PHP_MAX_EXECUTION_TIME=1800
PHP_MAX_INPUT_VARS=10000

# ------------------------------------------------------------
# Database (real, simple, LOCAL-ONLY creds)
# ------------------------------------------------------------

DB_NAME=magento
DB_USER=magento
DB_PASSWORD=magento
DB_ROOT_PASSWORD=magento
DB_PORT=3306

# ------------------------------------------------------------
# Valkey
# ------------------------------------------------------------

VALKEY_PORT=6379

# ------------------------------------------------------------
# RabbitMQ
# ------------------------------------------------------------

RABBITMQ_DEFAULT_USER=magento
RABBITMQ_DEFAULT_PASS=magento
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ------------------------------------------------------------
# OpenSearch
# ------------------------------------------------------------

OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_PREFIX=magento

# ------------------------------------------------------------
# Mailpit
# ------------------------------------------------------------

MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025

# ------------------------------------------------------------
# Nginx — no host ports of its own: the shared edge proxy
# (compose/edge/docker-compose.yml) owns 80/443 for every stack on this
# machine and routes https://APP_DOMAIN/ here by hostname.
#
# The *_PORT values above are only starting points — bin/platform up moves
# any port another stack (running or stopped) or process already holds to
# the next free one and saves it here, so several stacks can run at once.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Magento
# ------------------------------------------------------------

# default | developer | production — asked by bin/local/setup, applied by
# bin/refresh; switch later with bin/mode/<mode> (production also locks
# code read-only, see bin/permissions/*).
MAGENTO_MODE=developer
# single | two-owner — who php-fpm runs as (bin/lib/identity.sh); asked by
# bin/local/setup right after the mode; switch later with bin/ownership/<model>.
FILE_OWNERSHIP=single
MAGENTO_ADMIN_URI=admin
# Comma-separated list of modules to pass to setup:install's
# --disable-modules on the very first install, re-enabled right after (see
# bin/local/setup) — a workaround for modules whose plugins/helpers get
# eagerly constructed during Magento's own install process before the DB
# is fully ready. Blank = none. Example: Vendor_Module,Other_Module
MAGENTO_DISABLE_MODULES=

# ------------------------------------------------------------
# Remote Storage (S3-backed media) — used by bin/refresh.
# DRIVER is "file" (serve pub/media from local disk) or "aws-s3" (serve it
# from the bucket/region below, see bin/remote-storage.sh).
# BUCKET/REGION/KEY/SECRET only matter when DRIVER=aws-s3; leave them blank
# for DRIVER=file. bin/local/setup prompts for and fills in all five of
# these on first run — leave everything at CHANGE_ME here.
# ------------------------------------------------------------

REMOTE_STORAGE_DRIVER=CHANGE_ME
REMOTE_STORAGE_BUCKET=CHANGE_ME
REMOTE_STORAGE_REGION=CHANGE_ME
REMOTE_STORAGE_KEY=CHANGE_ME
REMOTE_STORAGE_SECRET=CHANGE_ME
# The AWS CLI profile used for S3 — picked from the profiles on this computer
# by setup / the refresh wizard (and remembered here and in .envrc).
AWS_PROFILE_DEFAULT=
