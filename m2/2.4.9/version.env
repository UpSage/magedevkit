# Magento 2.4.9 (base release, no security patch).
MAGENTO_VERSION=2.4.9
MAGENTO_PACKAGE=magento/project-community-edition

# Stack versions: Adobe system requirements data file
#   https://github.com/AdobeDocs/commerce-operations.en/blob/main/_jekyll/_data/system-requirements.yml
#   (checked 2026-10-05; file last changed 2026-08-10). Where Adobe lists
#   several versions, the highest supported is pinned. Compare any time with
#   bin/m2/check-requirements.
PHP_VERSION=8.5
MARIADB_VERSION=12.3
OPENSEARCH_VERSION=3
VALKEY_VERSION=9
RABBITMQ_VERSION=4.3
VARNISH_VERSION=8
NGINX_VERSION=1.30
COMPOSER_VERSION=2.10
# nginx 1.30 images exist for trixie only.
DEBIAN_RELEASE=trixie
