# Magento 2.4.8 (base release, no security patch).
MAGENTO_VERSION=2.4.8
MAGENTO_PACKAGE=magento/project-community-edition

# Stack versions: Adobe system requirements data file
#   https://github.com/AdobeDocs/commerce-operations.en/blob/main/_jekyll/_data/system-requirements.yml
#   (checked 2026-10-05; file last changed 2026-08-10). Where Adobe lists
#   several versions, the highest supported is pinned. Compare any time with
#   bin/m2/check-requirements.
PHP_VERSION=8.4
MARIADB_VERSION=11.4
# Adobe: OpenSearch 2.19 — no bare "2.19" image tag exists, so latest 2.19.x.
OPENSEARCH_VERSION=2.19.6
VALKEY_VERSION=8
RABBITMQ_VERSION=4.1
VARNISH_VERSION=7.6
NGINX_VERSION=1.26
# Adobe: Composer 2.9.3+
COMPOSER_VERSION=2.9
# nginx 1.26 images exist for bookworm only.
DEBIAN_RELEASE=bookworm
