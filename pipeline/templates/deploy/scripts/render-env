#!/usr/bin/env bash
# @@HEADER@@
#
# Writes the box's settings from two sources, before every deploy:
#   - deploy/targets/<ENV_NAME>.env  — non-secret target settings (in git)
#   - SSM Parameter Store /<APP>/<ENV_NAME>/* — the secrets (created by
#     deploy/infra; never in git, never in an image)
# into shared/.env (docker compose) and shared/env.php (Magento's
# app/etc/env.php — after-install.sh puts it in place).
#
#   render-env [TARGET_ENV_FILE]   default: $APP_HOME/deploy/targets/$ENV_NAME.env

LOG_TAG=render-env
# shellcheck disable=SC1091
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

TARGET_FILE="${1:-$DEPLOY_DIR/targets/$ENV_NAME.env}"
[ -f "$TARGET_FILE" ] || fail "target settings $TARGET_FILE not found."
set -a
# shellcheck disable=SC1090
source "$TARGET_FILE"
set +a

# /<APP>/<ENV_NAME>/<name> -> SECRET_<NAME>
prefix="/$APP/$ENV_NAME/"
declare -A SECRET=()
while IFS=$'\t' read -r name value; do
    [ -n "$name" ] && SECRET["${name#"$prefix"}"]="$value"
done < <(aws ssm get-parameters-by-path --region "$AWS_REGION" --path "$prefix" --with-decryption \
    --query 'Parameters[].[Name,Value]' --output text)
for k in db_password db_root_password rabbitmq_password crypt_key; do
    [ -n "${SECRET[$k]:-}" ] || fail "SSM parameter $prefix$k is missing — run the provision wizard (mrn provision-wizard)."
done

mkdir -p "$SHARED" "$BACKUP_DIR"
umask 077

tmp="$(mktemp "$SHARED/.env.XXXXXX")"
cat > "$tmp" <<EOF
# Generated by deploy/scripts/render-env on every deploy — don't edit here.
APP_NAME=$APP
APP_HOME=$APP_HOME
APP_DOMAIN=$APP_DOMAIN
ACME_EMAIL=$ACME_EMAIL
DEPLOY_UID=$(id -u)
DEPLOY_GID=$(id -g)
DB_NAME=magento
DB_USER=magento
DB_PASSWORD=${SECRET[db_password]}
DB_ROOT_PASSWORD=${SECRET[db_root_password]}
RABBITMQ_USER=magento
RABBITMQ_PASS=${SECRET[rabbitmq_password]}
OPENSEARCH_JAVA_OPTS=${OPENSEARCH_JAVA_OPTS:--Xms1g -Xmx1g}
VARNISH_CACHE_SIZE=${VARNISH_CACHE_SIZE:-512m}
TZ=${APP_TIMEZONE:-UTC}
EOF
mv "$tmp" "$SHARED/.env"

# Remote media storage (S3) when the target uses it; the instance role grants
# the bucket, so no keys are written.
REMOTE_STORAGE=""
if [ "${STORAGE_DRIVER:-file}" = aws-s3 ] && [ -n "${MEDIA_BUCKET:-}" ]; then
    REMOTE_STORAGE="
    'remote_storage' => [
        'driver' => 'aws-s3',
        'config' => ['bucket' => '${MEDIA_BUCKET}', 'region' => '${MEDIA_REGION:-$AWS_REGION}'],
    ],"
fi

INSTALL_DATE="$(date -u '+%a, %d %b %Y %H:%M:%S +0000')"
if [ -f "$SHARED/env.php" ]; then
    # Keep the first install date — Magento only checks that it's there.
    old="$(sed -n "s/.*'date' => '\(.*\)'.*/\1/p" "$SHARED/env.php" | head -1)"
    [ -n "$old" ] && INSTALL_DATE="$old"
fi

tmp="$(mktemp "$SHARED/env.php.XXXXXX")"
cat > "$tmp" <<EOF
<?php
// Generated by deploy/scripts/render-env on every deploy — don't edit here.
// Secrets come from SSM ${prefix}*; settings from deploy/targets/${ENV_NAME}.env.
return [
    'backend' => ['frontName' => '${ADMIN_URI}'],
    'crypt' => ['key' => '${SECRET[crypt_key]}'],
    'db' => [
        'table_prefix' => '',
        'connection' => [
            'default' => [
                'host' => 'mariadb',
                'dbname' => 'magento',
                'username' => 'magento',
                'password' => '${SECRET[db_password]}',
                'model' => 'mysql4',
                'engine' => 'innodb',
                'initStatements' => 'SET NAMES utf8;',
                'active' => '1',
                'driver_options' => [1014 => false],
            ],
        ],
    ],
    'resource' => ['default_setup' => ['connection' => 'default']],
    'x-frame-options' => 'SAMEORIGIN',
    'MAGE_MODE' => '${MAGENTO_MODE}',
    'session' => [
        'save' => 'redis',
        'redis' => ['host' => 'valkey', 'port' => '6379', 'database' => '2', 'disable_locking' => '1'],
    ],
    'cache' => [
        'frontend' => [
            'default' => ['backend' => 'Magento\\\\Framework\\\\Cache\\\\Backend\\\\Redis',
                'backend_options' => ['server' => 'valkey', 'port' => '6379', 'database' => '0']],
            'page_cache' => ['backend' => 'Magento\\\\Framework\\\\Cache\\\\Backend\\\\Redis',
                'backend_options' => ['server' => 'valkey', 'port' => '6379', 'database' => '1']],
        ],
        'allow_parallel_generation' => false,
    ],
    'queue' => [
        'amqp' => ['host' => 'rabbitmq', 'port' => '5672', 'user' => 'magento',
            'password' => '${SECRET[rabbitmq_password]}', 'virtualhost' => '/'],
        'consumers_wait_for_messages' => 1,
    ],
    'http_cache_hosts' => [['host' => 'varnish', 'port' => '80']],
    'lock' => ['provider' => 'db'],
    'directories' => ['document_root_is_pub' => true],
    'downloadable_domains' => ['${APP_DOMAIN}'],
    'install' => ['date' => '${INSTALL_DATE}'],
    'cache_types' => [
        'config' => 1, 'layout' => 1, 'block_html' => 1, 'collections' => 1, 'reflection' => 1,
        'db_ddl' => 1, 'compiled_config' => 1, 'eav' => 1, 'customer_notification' => 1,
        'config_integration' => 1, 'config_integration_api' => 1, 'full_page' => 1,
        'config_webservice' => 1, 'translate' => 1,
    ],${REMOTE_STORAGE}
    // Locked here so a database copied from another environment serves this
    // domain and finds this box's services.
    'system' => [
        'default' => [
            'web' => [
                'unsecure' => ['base_url' => 'https://${APP_DOMAIN}/'],
                'secure' => ['base_url' => 'https://${APP_DOMAIN}/', 'use_in_frontend' => '1', 'use_in_adminhtml' => '1'],
                'cookie' => ['cookie_domain' => '${APP_DOMAIN}'],
            ],
            'catalog' => ['search' => ['engine' => 'opensearch', 'opensearch_server_hostname' => 'opensearch',
                'opensearch_server_port' => '9200', 'opensearch_index_prefix' => '${APP}_${ENV_NAME}']],
            'system' => ['full_page_cache' => ['caching_application' => '2',
                'varnish' => ['backend_host' => 'nginx', 'backend_port' => '8080']]],
            'general' => ['locale' => ['timezone' => '${APP_TIMEZONE:-UTC}']],
        ],
    ],
];
EOF
mv "$tmp" "$SHARED/env.php"
log "✓ shared/.env and shared/env.php written (secrets from SSM $prefix*)"
