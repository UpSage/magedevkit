# @@HEADER@@
#
# Target "@@ENV_NAME@@": non-secret settings, read on the box by
# deploy/scripts/render-env. Secrets live in SSM under /@@APP@@/@@ENV_NAME@@/.
# Change them with the pipeline wizard (mdk pipeline-wizard), not here.

ENV_NAME=@@ENV_NAME@@
APP=@@APP@@
AWS_REGION=@@AWS_REGION@@
APP_DOMAIN=@@APP_DOMAIN@@
ACME_EMAIL=@@ACME_EMAIL@@
MAGENTO_MODE=@@MAGENTO_MODE@@
ADMIN_URI=@@ADMIN_URI@@
APP_TIMEZONE=@@APP_TIMEZONE@@
STATIC_LOCALES="@@STATIC_LOCALES@@"
STORAGE_DRIVER=@@STORAGE_DRIVER@@
MEDIA_BUCKET=@@MEDIA_BUCKET@@
MEDIA_REGION=@@MEDIA_REGION@@
