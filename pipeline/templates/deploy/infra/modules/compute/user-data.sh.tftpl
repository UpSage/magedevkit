#!/bin/bash
# @@HEADER@@
# First boot of the box: Docker, the AWS CLI, the CodeDeploy agent, a 4 GB
# swap file, the deploy user and /opt/<app>. Runs once; later changes come
# through deploys.
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y docker.io docker-compose-v2 rsync unzip curl jq gzip ruby-full wget

curl -fsSL -o /tmp/awscliv2.zip https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install --update

wget -q -O /tmp/codedeploy-install https://aws-codedeploy-${region}.s3.${region}.amazonaws.com/latest/install
chmod +x /tmp/codedeploy-install
/tmp/codedeploy-install auto
systemctl enable --now codedeploy-agent

if [ ! -f /swapfile ]; then
  fallocate -l 4G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
sysctl -w vm.max_map_count=262144
echo 'vm.max_map_count=262144' > /etc/sysctl.d/99-opensearch.conf

id deploy >/dev/null 2>&1 || useradd --create-home --shell /bin/bash deploy
usermod -aG docker deploy
mkdir -p /opt/${app}/magento /opt/${app}/deploy /opt/${app}/shared /opt/${app}/incoming
chown -R deploy:deploy /opt/${app}

cat > /etc/m2deploy.env <<CONF
APP=${app}
ENV_NAME=${env}
AWS_REGION=${region}
APP_HOME=/opt/${app}
CONF
chmod 644 /etc/m2deploy.env
