#!/bin/bash

set -euo pipefail

# Switches Magento to production mode (compiles, deploys static content, then locks code read-only).
# See bin/lib/mode-engine.sh for what this does. Safe to re-run; switch back any time
# by running the sibling command.

PLATFORM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# shellcheck disable=SC1091
source "$PLATFORM_DIR/bin/lib/mode-engine.sh"
set_mode production
