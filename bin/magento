#!/bin/bash

set -euo pipefail

PLATFORM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck disable=SC1091
source "$PLATFORM_DIR/bin/lib/paths.sh"
require_env_file

# CLI identity (EXEC_USER) and php-fpm's PHP_UID/PHP_GID both come from
# FILE_OWNERSHIP — see bin/lib/identity.sh. Exported here too so docker
# compose's substitution for the php `user:` field never falls back to blank.
# shellcheck disable=SC1091
source "$PLATFORM_DIR/bin/lib/identity.sh"

# Nobody at a keyboard (browser wizard, dashboard, scripts): no TTY for the
# container, and Magento's --no-interaction, so a confirmation question
# (e.g. app:config:import's "Do you want to continue [yes/no]?" during
# setup:upgrade) proceeds instead of reading EOF and aborting.
TTY_FLAG=()
NO_INTERACTION=()
if [ ! -t 0 ]; then
    TTY_FLAG=(-T)
    NO_INTERACTION=(--no-interaction)
fi
docker compose \
    --env-file "$ENV_FILE" \
    -f "$PLATFORM_DIR/compose/docker-compose.yml" \
    -f "$PLATFORM_DIR/compose/docker-compose.local.yml" \
    exec \
    "${TTY_FLAG[@]}" \
    --user "$EXEC_USER" \
    php \
    php bin/magento "${NO_INTERACTION[@]}" "$@"
