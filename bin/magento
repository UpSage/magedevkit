#!/bin/bash

set -euo pipefail

PLATFORM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck disable=SC1091
source "$PLATFORM_DIR/bin/lib/paths.sh"
require_env_file

# CLI identity (EXEC_USER) and php-fpm's PHP_UID/PHP_GID both come from
# FILE_OWNERSHIP — see bin/lib/identity.sh. Exported here too so docker
# compose's substitution for the php `user:` field never falls back to blank.
# shellcheck disable=SC1091
source "$PLATFORM_DIR/bin/lib/identity.sh"

# Out-of-date compiled code would crash this command before it starts (see
# bin/lib/generated.sh). Developer/default mode doesn't need it — clear it
# and Magento regenerates what it uses. Production serves the store from
# it, so leave it and say what to run. When the check itself fails, nothing
# is cleared. mdk build clears it itself and sets MDK_SKIP_GENERATED_CHECK
# for its own steps.
if [ "${MDK_SKIP_GENERATED_CHECK:-}" != 1 ]; then
    # shellcheck disable=SC1091
    source "$PLATFORM_DIR/bin/lib/generated.sh"
    stale=0
    reason="$(generated_stale)" || stale=$?
    if [ "$stale" = 2 ]; then
        echo "⚠ Couldn't check whether the compiled code is up to date — running the command anyway." >&2
    elif [ "$stale" = 0 ]; then
        if [ "$(env_get "$ENV_FILE" MAGENTO_MODE)" = production ]; then
            echo "⚠ Compiled code looks out of date ($reason). If this fails with 'Class … not found', run Build Magento: $(cmd_hint build)" >&2
        else
            clear_generated
            echo "Compiled code was out of date ($reason) — cleared it; Magento regenerates it as needed. Run Build Magento for a full compile." >&2
        fi
    fi
fi

# Nobody at a keyboard (browser wizard, dashboard, scripts): no TTY for the
# container, and Magento's --no-interaction, so a confirmation question
# (e.g. app:config:import's "Do you want to continue [yes/no]?" during
# setup:upgrade) proceeds instead of reading EOF and aborting.
TTY_FLAG=()
NO_INTERACTION=()
if [ ! -t 0 ]; then
    TTY_FLAG=(-T)
    NO_INTERACTION=(--no-interaction)
fi
docker compose \
    --env-file "$ENV_FILE" \
    -f "$PLATFORM_DIR/compose/docker-compose.yml" \
    -f "$PLATFORM_DIR/compose/docker-compose.local.yml" \
    exec \
    "${TTY_FLAG[@]}" \
    --user "$EXEC_USER" \
    php \
    php bin/magento "${NO_INTERACTION[@]}" "$@"
