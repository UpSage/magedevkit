#!/bin/bash

set -e

# PLATFORM_DIR, MAGENTO and the shared helpers (ui.sh, env.sh, paths.sh).
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.sh"

# install_mkcert / install_aws_cli / install_direnv (only when a step needs them).
# shellcheck disable=SC1091
source "$PLATFORM_DIR/bin/lib/tools.sh"

# One-command local environment bootstrap. The wizard itself (prompts,
# mkcert/TLS, nginx-local config, Magento install, storage driver, data
# refresh) lives in bin/lib/setup-engine.sh — this file supplies the paths
# and the lock. Safe to re-run any time: every step checks
# "is this already done?" before acting. Covers LOCAL_SETUP.md steps 5-17.

# The shared platform repo isn't a store — instances are made with new-instance.
paths_is_shared_repo && fail "This is the shared platform repo, not an instance — create one with: mdk new NAME — or run mdk setup inside an instance folder (or with -i NAME)."
# EXEC_USER/PHP_UID/PHP_GID from FILE_OWNERSHIP — re-sourced by the engine
# after its ownership prompt. See bin/lib/identity.sh.
# shellcheck disable=SC1091
source "$PLATFORM_DIR/bin/lib/identity.sh"

# One setup/refresh at a time per checkout; the step rail belongs to setup.
wizard_lock
ui_flow_begin setup
ui_log_to_file setup

# shellcheck disable=SC1091
source "$PLATFORM_DIR/bin/lib/setup-engine.sh"
