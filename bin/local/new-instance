#!/bin/bash
# Creates a new Magento instance folder that runs on this (shared) platform
# repo, then starts its setup wizard:
#
#   bin/local/new-instance NAME [--no-setup] [--terminal] [--no-browser]
#
#   ~/Sites/NAME/                  (next to this repo; PLATFORM_INSTANCES_ROOT overrides)
#   ├── .platform-instance         marker — PLATFORM_REPO=<this repo>
#   ├── .env                       settings, from env/.env.local.example (APP_NAME=NAME)
#   ├── magento/                   filled by setup (fresh download or GitHub clone) —
#   │                              the store's own git repo, the only thing ever pushed
#   └── nginx/ certs/ logs/ db/    generated vhost, mkcert certificate, logs, backups
#
# An instance folder holds data only — no scripts. Commands for it go
# through `mdk` (bin/mdk, installed with bin/local/install-mdk):
#   cd ~/Sites/NAME && mdk magento cache:flush      or      mdk -i NAME platform up -d
#
# NAME becomes APP_NAME (Docker project NAME-platform, volumes NAME-*):
# lowercase letters, digits, _ and -.
#
#   --no-setup     only create the folder (the dashboard's New instance uses this)
#   --terminal     run bin/local/setup in this terminal instead of the browser wizard
#   --no-browser   print the setup wizard's link instead of opening it
#
# Safe to re-run on an existing instance: it refreshes the marker (e.g. after
# the repo moved), removes bin/ launchers made by older versions of this
# command, and keeps .env and everything else.

set -euo pipefail

PLATFORM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# Run as `mdk new` from inside an instance, this still creates a *new* folder.
unset PLATFORM_INSTANCE_DIR
# shellcheck disable=SC1091
source "$PLATFORM_DIR/bin/lib/ui.sh"
# shellcheck disable=SC1091
source "$PLATFORM_DIR/bin/lib/env.sh"
# valid_instance_name / project_owner
# shellcheck disable=SC1091
source "$PLATFORM_DIR/bin/lib/util.sh"

NAME=""
SETUP=browser
WIZARD_ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --no-setup) SETUP=none ;;
        --terminal) SETUP=terminal ;;
        --no-browser) WIZARD_ARGS+=(--no-browser) ;;
        -h|--help) script_help "${BASH_SOURCE[0]}"; exit 0 ;;
        -*) fail "Unknown option '$1' (expected --no-setup, --terminal or --no-browser)." ;;
        *) [ -z "$NAME" ] || fail "Only one NAME, please (got '$NAME' and '$1')."; NAME="$1" ;;
    esac
    shift
done
[ -n "$NAME" ] || fail "Usage: bin/local/new-instance NAME [--no-setup] [--terminal] [--no-browser]"

# Same rule as setup's project name (valid_instance_name, bin/lib/util.sh).
valid_instance_name "$NAME" \
    || fail "Invalid name '$NAME' — lowercase letters, digits, _ and - only (max 40), starting with a letter or digit."

ROOT="${PLATFORM_INSTANCES_ROOT:-$(dirname "$PLATFORM_DIR")}"
[ -d "$ROOT" ] || fail "Instances folder $ROOT doesn't exist."
ROOT="$(cd "$ROOT" && pwd)"
DIR="$ROOT/$NAME"
[ "$DIR" != "$PLATFORM_DIR" ] || fail "'$NAME' is the platform repo's own folder — pick another name."
if [ -e "$DIR" ] && [ ! -f "$DIR/.platform-instance" ]; then
    fail "$DIR already exists and isn't an instance folder — pick another name (or move that folder away)."
fi

# Another stack already using this name? (Its containers carry the name.)
if command -v docker >/dev/null 2>&1 && docker ps >/dev/null 2>&1; then
    OWNER="$(project_owner "$NAME" "$DIR")"
    [ -z "$OWNER" ] || fail "The name '$NAME' is already used by the stack in $OWNER (Docker project $NAME-platform) — pick another name."
fi

NEW=0
[ -f "$DIR/.platform-instance" ] || NEW=1
mkdir -p "$DIR"/{magento,nginx,certs,logs,db}
cat > "$DIR/.platform-instance" <<EOF
# Magento instance running on the shared platform repo below — see
# bin/local/new-instance and bin/lib/paths.sh there. Commands: mdk (bin/mdk).
PLATFORM_REPO=$PLATFORM_DIR
EOF

if [ ! -f "$DIR/.env" ]; then
    cp "$PLATFORM_DIR/env/.env.local.example" "$DIR/.env"
    chmod 600 "$DIR/.env"
    set_env_var "$DIR/.env" APP_NAME "$NAME"
    # Hostnames can't contain "_"; setup still asks, this is only the default.
    set_env_var "$DIR/.env" APP_DOMAIN "${NAME//_/-}.test"
fi

# Older versions put launcher scripts in <instance>/bin; mdk replaces them.
# Only files carrying their marker are removed — anything else stays.
if [ -d "$DIR/bin" ]; then
    REMOVED=0
    while IFS= read -r -d '' f; do
        if grep -q '^# Generated by bin/local/new-instance' "$f" 2>/dev/null; then
            rm -f "$f"
            REMOVED=$((REMOVED + 1))
        fi
    done < <(find "$DIR/bin" -type f -print0)
    find "$DIR/bin" -depth -type d -empty -delete 2>/dev/null || true
    [ "$REMOVED" = 0 ] || log "Removed $REMOVED old bin/ launchers — use mdk instead (bin/local/install-mdk)."
fi

if [ "$NEW" = 1 ]; then
    log "Created instance $NAME in $DIR."
else
    log "Instance $NAME already exists in $DIR — .env and data untouched."
fi

export PLATFORM_INSTANCE_DIR="$DIR"
case "$SETUP" in
    none)
        log "Next: cd $DIR && mdk setup-wizard   (or: mdk -i $NAME setup-wizard)"
        exit 0 ;;
    terminal) exec "$PLATFORM_DIR/bin/local/setup" ;;
    *) exec "$PLATFORM_DIR/bin/local/setup-wizard" "${WIZARD_ARGS[@]}" ;;
esac
