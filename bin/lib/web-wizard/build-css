#!/bin/bash
# Rebuilds ui/wizard.css from ui/input.css with the Tailwind v4 standalone CLI
# (a single binary — no Node). Only needed after changing classes in
# ui/*.html or ui/*.js (wizard and dashboard); the result is committed, users
# never run this.
#   --check   exit 1 if the committed wizard.css is out of date
set -euo pipefail

TAILWIND_VERSION=v4.3.3
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/platform-tailwind/$TAILWIND_VERSION"

# SHA-256 of each binary of $TAILWIND_VERSION, as published with the release
# (its sha256sums.txt). Update both when bumping the version.
case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) ASSET=tailwindcss-linux-x64; SHA256=dc61b3ac6b8c9ca874c0cc4c57b2409791a64c5540404ca5f5367360babc313a ;;
    Linux-aarch64) ASSET=tailwindcss-linux-arm64; SHA256=55fd0b241214eff3de1e8ee4f22796662f2d2e7a49bcfca7477cfd0bac398195 ;;
    Darwin-arm64) ASSET=tailwindcss-macos-arm64; SHA256=cdf646702987a743464dff4d9c60fd4480d1c1e73dd819a9a67f1078815dce9d ;;
    Darwin-x86_64) ASSET=tailwindcss-macos-x64; SHA256=7922e0953f2110c05976e3bf58f14e643d90427575e766b7d433f5f80cbee7e1 ;;
    *) echo "Unsupported platform $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac
BIN="$CACHE/$ASSET"
if [ ! -x "$BIN" ]; then
    mkdir -p "$CACHE"
    echo "Downloading Tailwind $TAILWIND_VERSION ($ASSET) ..." >&2
    curl -fsSL -o "$BIN.tmp" "https://github.com/tailwindlabs/tailwindcss/releases/download/$TAILWIND_VERSION/$ASSET"
    got="$( (sha256sum "$BIN.tmp" 2>/dev/null || shasum -a 256 "$BIN.tmp") | cut -d' ' -f1)"
    if [ "$got" != "$SHA256" ]; then
        rm -f "$BIN.tmp"
        echo "The Tailwind download doesn't match its published checksum — not using it." >&2
        exit 1
    fi
    chmod +x "$BIN.tmp"
    mv "$BIN.tmp" "$BIN"
fi

OUT="$DIR/ui/wizard.css"
if [ "${1:-}" = --check ]; then
    TMP="$(mktemp)"
    trap 'rm -f "$TMP"' EXIT
    (cd "$DIR/ui" && "$BIN" -i input.css -o "$TMP" --minify >/dev/null 2>&1)
    cmp -s "$TMP" "$OUT" && echo "wizard.css is up to date." || { echo "wizard.css is out of date — run $0" >&2; exit 1; }
else
    (cd "$DIR/ui" && "$BIN" -i input.css -o "$OUT" --minify)
    echo "Wrote ${OUT#"$DIR/"} ($(wc -c < "$OUT") bytes)."
fi
